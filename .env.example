# LLM
# 在线模型: deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
# 本地模型: ./models/DeepSeek-R1-Distill-Qwen-7B
LLM_MODEL_NAME=./models/DeepSeek-R1-Distill-Qwen-7B
# auto | cuda | cpu — RTX 5070 请用 cuda
LLM_DEVICE=cuda
# 12GB 显存建议开启 4bit 量化（需 bitsandbytes + CUDA 版 PyTorch）
LLM_LOAD_IN_4BIT=true
LLM_MAX_NEW_TOKENS=1024
LLM_TEMPERATURE=0.3

# Embeddings
# 在线模型: BAAI/bge-small-zh-v1.5
# 本地模型: ./models/bge-small-zh-v1.5
EMBEDDING_MODEL_NAME=./models/bge-small-zh-v1.5
EMBEDDING_DEVICE=cuda

# ChromaDB
CHROMA_PERSIST_DIR=./chroma
CHROMA_COLLECTION=visiontext_rag

# Knowledge base
KNOWLEDGE_DIR=./knowledge

# RAG
TOP_K=4
CHUNK_SIZE=600
CHUNK_OVERLAP=80

# Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
